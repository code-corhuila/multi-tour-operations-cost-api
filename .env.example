# Names and placeholders only: never a real value. Copy to .env for local runs.
PORT=8084
# Public key of the security microservice (one line, \n escapes) or the path of a file that holds it
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_FILE=
# The single PostgreSQL instance (multi-tour-infra-postgres); the service connects as operations_cost_app, never as the administrator
DATABASE_URL=jdbc:postgresql://postgres:5432/multitour
DATABASE_USER=operations_cost_app
DATABASE_PASSWORD=
# The API of commercial-reservation, which owns the catalog of the tours: the service reads it with the credential of the caller
COMMERCIAL_RESERVATION_BASE_URL=http://commercial-reservation-api:8083
